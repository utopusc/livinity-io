# Phase 150-B — sudoers entry for the LivOS native-installer.
#
# Allows the `bruce` user (the per-LivOS-instance unprivileged user) to
# run apt-get install for the v37 native catalog without a password.
# Drop this file at /etc/sudoers.d/livos-native (mode 0440, root-owned).
#
# Security model:
# - Single explicit binary: /usr/bin/apt-get (not /bin/apt, which is a
#   different shim). The sudoers `Cmnd_Alias` is exact-match: any other
#   apt-get arguments OR any other binary will be rejected.
# - No env preservation (`!setenv` not needed since we never pass env
#   through; sudo strips by default).
# - The `*` glob covers package args. apt-get itself only allows real
#   package names from configured repositories, so even if a manifest
#   passed arbitrary strings here, apt would reject them.
#
# To add another permitted apt operation (e.g. apt-get autoremove),
# extend the Cmnd_Alias — don't grant broader sudoers.
#
# Deploy:
#   sudo install -m 0440 -o root -g root livos-native /etc/sudoers.d/livos-native
#   sudo visudo -c   # syntax-check
#
# Operator UAT for Phase 150-B:
#   sudo -u bruce -n /usr/bin/apt-get install -y gimp  # → installs
#   sudo -u bruce -n /usr/bin/apt-get install -y --force-yes evil  # → denied (flag not allowed)
#   sudo -u bruce -n /usr/bin/apt-get remove gimp  # → denied (subcommand not allowed)

# Phase 259 — also allow `apt-get update` (best-effort cache refresh before
# install so newly-added repo packages and .deb dependencies resolve), and keep
# DEBIAN_FRONTEND across sudo so apt runs fully non-interactively on the headless
# Mini PC (no debconf/conffile prompt can hang an install).
# Phase 259 round 2 — the `apt-repo` install method (Brave/Signal/Spotify …) adds a
# 3rd-party repo + key via a single allow-listed helper. The helper does ALL the
# privileged work (keyring + sources.list.d write + apt-get update); sudoers grants
# only this exact path, so no broad root (no arbitrary tee/cp) is exposed.
# Phase 290+ (v44.57) — admin .snap upload installs via `snap install --dangerous <path>`
# (a local sideloaded bundle has no assertions; --dangerous skips that check). The
# trailing `*` only matches the bundle path argument, keeping the grant tightly scoped —
# same reasoning as `apt-get install -y *` above (snapd accepts only a real .snap file).
# AppImage (libfuse2) and Flatpak (--user scope) need NO root grant, so only snap is here.
Cmnd_Alias LIVOS_NATIVE = /usr/bin/apt-get install -y *, /usr/bin/apt-get update, /usr/local/lib/livos/livos-add-apt-repo.sh *, /usr/bin/snap install --dangerous *

Defaults!LIVOS_NATIVE env_keep += "DEBIAN_FRONTEND"

bruce ALL=(root) NOPASSWD: LIVOS_NATIVE
