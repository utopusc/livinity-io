# Phase 192-01 — sudoers entries for livinityd running as the `bruce` user.
#
# Allows bruce (livinityd uid) to run the narrow set of root-equivalent
# commands identified by .planning/phases/192-livinityd-bruce-user-switch/
# 192-AUDIT.md (sections SUDO_WRAPPER #19-#22).
#
# No passwordless-everything (blanket) grant — every entry is a scoped
# Cmnd_Alias. No shell wildcards inside binary paths. Globs only in
# argument-position, following the precedent established by
# scripts/install/sudoers.d/livos-native (Phase 150-B).
#
# Deploy:
#   sudo install -m 0440 -o root -g root livinityd /etc/sudoers.d/livinityd
#   sudo visudo -c   # syntax-check
#
# Security model:
# - Each Cmnd_Alias targets EXACTLY ONE binary path (no shell shims like /bin/sh).
# - Globs appear only AFTER the binary path (argument position).
# - Two Runas spec lines: `(root)` for chown/Xvfb/x11vnc which need root caps;
#   `(bruce)` self-target Runas for the `sudo -u bruce <cmd>` patterns from
#   the v37 code that pre-dates the bruce-user cutover (transitional).
# - To grant a new privilege: extend the Cmnd_Alias list — do NOT broaden the
#   runas spec to ALL. Wholesale unrestricted NOPASSWD on bruce is precisely
#   what Phase 192 is replacing.
#
# Audit hand-off: 192-AUDIT.md "Sudoers Command List" enumerates the rationale
# for each Cmnd_Alias entry below; widening this file MUST update both.

# 19. apps.ts:218 — Tor data dir chown to container uid 1000
Cmnd_Alias LIVINITYD_CHOWN_DOCKER_DATA = /usr/bin/chown -R 1000\:1000 *

# 20. server/index.ts:1894 — WebApp Launcher Chrome shim
Cmnd_Alias LIVINITYD_LAUNCH_CHROME = /usr/local/bin/livos-launch-chrome *

# 21. streaming/xvfb-spawner.ts, vnc-bridge.ts — virtual display + VNC
Cmnd_Alias LIVINITYD_XVFB   = /usr/bin/Xvfb *
Cmnd_Alias LIVINITYD_X11VNC = /usr/bin/x11vnc *

# 22. chrome-master/master-login-routes.ts — google-chrome spawn under bruce
Cmnd_Alias LIVINITYD_GOOGLE_CHROME = /usr/bin/google-chrome *

# Adjacent: xdotool window-control invocations co-located with the chrome flows
Cmnd_Alias LIVINITYD_XDOTOOL = /usr/bin/xdotool *

# Runas=root: actions that genuinely require root caps (CAP_CHOWN on non-bruce
# files, CAP_NET_RAW/CAP_SYS_ADMIN for X server setup).
bruce ALL=(root) NOPASSWD: LIVINITYD_CHOWN_DOCKER_DATA, LIVINITYD_XVFB, LIVINITYD_X11VNC, LIVINITYD_XDOTOOL

# Runas=bruce: self-target `sudo -u bruce <cmd>` patterns. Pre-cutover livinityd
# (uid=0) used these to drop to bruce; post-cutover livinityd IS bruce, so
# these become near no-ops. Keeping the entries lets the transition land
# without operator action, and v38.4 polish will drop the `sudo -u bruce`
# prefixes from the source code (then these aliases can be retired).
bruce ALL=(bruce) NOPASSWD: LIVINITYD_LAUNCH_CHROME, LIVINITYD_GOOGLE_CHROME, LIVINITYD_XVFB, LIVINITYD_X11VNC, LIVINITYD_XDOTOOL

# 23. Phase 196-05 — onboarding locale-timezone step ships timedatectl set-timezone
Cmnd_Alias LIVINITYD_TIMEDATECTL = /usr/bin/timedatectl set-timezone *
bruce ALL=(root) NOPASSWD: LIVINITYD_TIMEDATECTL

# 24. Phase 262 WS3 (LIVOS-043) — fail2ban Settings panel (fail2ban-admin/client.ts).
# Exact subcommand shapes only — status reads, per-jail banip/unbanip, and the
# per-jail addignoreip whitelist. NEVER a bare `/usr/bin/fail2ban-client *`
# (that would also grant the global-flush `unban`, config reload, `set ...
# action*`, etc.). client.ts validates jail (/^[a-zA-Z0-9_.-]+$/) and IPv4 via
# zod+regex BEFORE every spawn, and invokes via `sudo -n` so the panel works
# under this scoped grant with no blanket drop-in present.
Cmnd_Alias LIVINITYD_FAIL2BAN = /usr/bin/fail2ban-client status, /usr/bin/fail2ban-client status *, /usr/bin/fail2ban-client set * banip *, /usr/bin/fail2ban-client set * unbanip *, /usr/bin/fail2ban-client set * addignoreip *
bruce ALL=(root) NOPASSWD: LIVINITYD_FAIL2BAN

# 25. Phase 262 WS3 (LIVOS-043 completion) — found during live deploy+pentest that the
# blanket /etc/sudoers.d/99-bruce was being relied on by THREE things the WS3 fragment
# did not cover, so removing the blanket broke them. Adding scoped grants:
#
# (a) The "Update LivOS" button: system/update.ts shells out
#     `sudo -n bash /opt/livos/update.sh`. Granting this is ONLY safe because
#     /opt/livos/update.sh is root-owned (deploy-livinityd.sh + update.sh self-chown to
#     root:root 0755 — bruce can execute but NOT rewrite it, so it cannot be hijacked
#     into arbitrary root). NEVER grant `bash *` or a bruce-writable script path.
Cmnd_Alias LIVINITYD_UPDATE = /usr/bin/bash /opt/livos/update.sh, /bin/bash /opt/livos/update.sh
bruce ALL=(root) NOPASSWD: LIVINITYD_UPDATE

# (b) Display window-manager + helper binaries co-located with the Xvfb/Chrome flows
#     (per-webapp fluxbox WM + wmctrl). Self-target (bruce) — no root escalation; these
#     run on the operator's own X displays.
Cmnd_Alias LIVINITYD_FLUXBOX = /usr/bin/fluxbox *
Cmnd_Alias LIVINITYD_WMCTRL  = /usr/bin/wmctrl *
bruce ALL=(bruce) NOPASSWD: LIVINITYD_FLUXBOX, LIVINITYD_WMCTRL

# (c) Restart/reload of the LivOS service units ONLY (operational: ops + UI restart
#     paths). Restart-only of fixed units = low risk; bruce already owns this code. This
#     is NOT a general `systemctl *` grant.
Cmnd_Alias LIVINITYD_SVC = /usr/bin/systemctl restart livos, /usr/bin/systemctl restart liv-core, /usr/bin/systemctl restart liv-worker, /usr/bin/systemctl restart liv-memory, /usr/bin/systemctl restart liv-assistant, /usr/bin/systemctl restart caddy, /usr/bin/systemctl reload caddy, /bin/systemctl restart livos, /bin/systemctl restart liv-core, /bin/systemctl restart liv-worker, /bin/systemctl restart liv-memory, /bin/systemctl restart liv-assistant, /bin/systemctl restart caddy, /bin/systemctl reload caddy
bruce ALL=(root) NOPASSWD: LIVINITYD_SVC

# NOTE (defense-in-depth gap documented during the Phase 262 pentest): removing the
# sudoers blanket does NOT by itself remove bruce's root, because bruce is in the
# `docker` group — the docker socket is a root-equivalent (a bruce-shell can
# `docker run -v /:/host …` → root). Fully de-rooting bruce/the AI agent requires a
# docker-socket proxy + removing bruce from the docker group (separate architectural
# phase). See SECURITY-RESEARCH-PASS-3.md.
