# Phase 306 — sudoers drop-in for the desktop-user password reset helper.
#
# When the operator clicks "Regenerate" on the Desktop password row in
# Settings → Account (admin-gated), livinityd's `system.regenerateDesktopPassword`
# mutation runs:
#   sudo -n /usr/local/lib/livos/set-desktop-password.sh
# The wrapper generates a fresh random password IN-SCRIPT (never an argv), sets
# the desktop user's OS password via chpasswd, ensures sudo-group membership, and
# rewrites /etc/livos/desktop-user-credentials.
#
# INV-306-01 — ONLY this one exact binary. No arguments, no glob, no shell shim.
#
# Deploy (subject `bruce` is templated to the real desktop user at deploy/update
# time — see update.sh:2347 + deploy-livinityd.sh, identical to sudoers.d/livos-native):
#   sudo install -m 0440 -o root -g root livos-desktop-password \
#     /etc/sudoers.d/livos-desktop-password
#   sudo visudo -c -f /etc/sudoers.d/livos-desktop-password   # syntax-check
#
# Security model:
# - Single explicit binary path: /usr/local/lib/livos/set-desktop-password.sh
#   (root-owned 0755 — the desktop user cannot rewrite it to hijack the grant).
# - The wrapper itself REFUSES to touch root or any uid<1000 account, so even
#   this grant cannot be turned into "change root's password".
# - NOPASSWD (non-interactive), mirrored from sudoers.d/livos-claw-gateway.
# - To change the privilege: edit the wrapper — do NOT widen this Cmnd_Alias to
#   chpasswd/passwd directly (that would allow changing ANY account).

Cmnd_Alias LIVOS_DESKTOP_PASSWORD = /usr/local/lib/livos/set-desktop-password.sh

bruce ALL=(root) NOPASSWD: LIVOS_DESKTOP_PASSWORD
