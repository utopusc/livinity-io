[Unit]
Description=Liv AI Claw Gateway (openclaw runtime + @livos/liv-claw-os plugin, port 18789)
Documentation=https://github.com/utopusc/livinity-io/blob/master/.planning/phases/203-liv-ai-openclaw-os/203-03-PLAN.md
After=network-online.target livos.service
Wants=network-online.target
Requires=livos.service

[Service]
Type=simple
User=bruce
Group=bruce
WorkingDirectory=/opt/livos/packages/liv-claw-gateway
# NOTE on env precedence: in this systemd version (256+, Ubuntu 24.04),
# EnvironmentFile= clobbers preceding Environment= directives at process spawn
# time despite the documented "Environment= takes precedence" rule (observed
# 2026-05-23 — gateway repeatedly bound to :8080 from /opt/livos/.env PORT=8080
# despite Environment=PORT=18789 in the unit). Workaround: load .env into a
# scoped EnvironmentFile that has only the keys the gateway actually needs,
# OR don't load /opt/livos/.env at all. Gateway only needs LLM provider keys
# (which are read lazily on first tool call), so we drop EnvironmentFile and
# require operators to add provider keys directly via Environment= here or
# via a per-service .env at /etc/default/liv-claw-gateway.
EnvironmentFile=-/etc/default/liv-claw-gateway
Environment=NODE_ENV=production
Environment=PORT=18789
Environment=OPENCLAW_PORT=18789
Environment=OPENCLAW_BIND=loopback
Environment=OPENCLAW_GATEWAY_AUTH=token
Environment=OPENCLAW_HOME=/opt/livos/data/openclaw
Environment=OPENCLAW_STATE_DIR=/opt/livos/data/openclaw
ExecStart=/usr/bin/env bash /opt/livos/packages/liv-claw-gateway/start.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
