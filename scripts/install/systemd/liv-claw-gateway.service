[Unit]
Description=Liv AI Claw Gateway (openclaw runtime + @livos/liv-claw-os plugin, port 18789)
Documentation=https://github.com/utopusc/livinity-io/blob/master/.planning/phases/203-liv-ai-openclaw-os/203-03-PLAN.md
After=network-online.target livos.service
Wants=network-online.target
Requires=livos.service

[Service]
Type=simple
User=bruce
Group=bruce
WorkingDirectory=/opt/livos/packages/liv-claw-gateway
# IMPORTANT: EnvironmentFile is loaded FIRST, then any Environment= directives
# below override it. /opt/livos/.env carries PORT=8080 for livinityd; we need
# PORT=18789 for the openclaw gateway, so the Environment= overrides MUST come
# AFTER the EnvironmentFile to win. (Fixed P203-12 deploy: gateway was binding
# to 8080 because the .env clobbered the unit-default.)
EnvironmentFile=-/opt/livos/.env
Environment=NODE_ENV=production
Environment=PORT=18789
Environment=OPENCLAW_PORT=18789
Environment=OPENCLAW_BIND=loopback
Environment=OPENCLAW_GATEWAY_AUTH=token
Environment=OPENCLAW_HOME=/opt/livos/data/openclaw
Environment=OPENCLAW_STATE_DIR=/opt/livos/data/openclaw
ExecStart=/usr/bin/env bash /opt/livos/packages/liv-claw-gateway/start.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
