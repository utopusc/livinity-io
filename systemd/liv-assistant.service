[Unit]
Description=Liv Assistant (AionUi WebUI, vendored v2.1.4)
Documentation=file:///opt/liv-assistant/UPSTREAM.md
Documentation=https://github.com/iOfficeAI/AionUi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bruce
Group=bruce
WorkingDirectory=/opt/liv-assistant/current
Environment="PATH=/home/bruce/.bun/bin:/usr/local/bin:/usr/bin:/bin"
Environment="HOME=/home/bruce"
# Phase 245.2 hotfix — extend MCP init timeout for 6 parallel `npx tsx` cold-starts.
# Default Claude Code MCP timeout is too short; without this, only aionui-team-guide
# (native binary) connects; the 5 stdio tsx-based local MCPs (liv-system / liv-vault /
# liv-apps / liv-docker / luse) time out silently and never register tools to the agent.
Environment="MCP_TIMEOUT=30000"
# Phase 253 GC-E — Gemini CLI 0.44.x "Folder Trust": in --experimental-acp mode
# it trust-checks its CWD (an aioncore conversations temp dir, not in
# trustedFolders.json) and on "untrusted" walks ancestors looking for GEMINI.md,
# lstat'ing /root/GEMINI.md → EACCES (we run as bruce) → process crashes → the
# ACP `initialize` handshake times out 30s → chat 502. This official bypass env
# marks the workspace trusted and skips the scan, so gemini chat works.
Environment="GEMINI_CLI_TRUST_WORKSPACE=true"
# Phase 252 (R5) — inherit REDIS_URL/DATABASE_URL from the shared env file the
# other livos units use. The `-` prefix makes a missing file non-fatal (fresh
# box before env-seed runs). aioncore→claude→luse then resolve Redis via
# resolveLuseRedisUrl step 2 (REDIS_URL) with no dependence on the per-MCP env seed.
EnvironmentFile=-/opt/livos/.env
# Phase 262 WS1 (LIVOS-049) — pin aionui-web to loopback (DIRECT control).
# Probe result (upstream iOfficeAI/AionUi packages/web-cli/src/index.ts +
# packages/web-host/src/static-server.ts, 2026-06-09): there is NO --host
# flag; the bind is binary — `host = allowRemote ? '0.0.0.0' : '127.0.0.1'`,
# where allowRemote comes from the `--remote` flag (absent from ExecStart
# below) or the AIONUI_ALLOW_REMOTE / AIONUI_REMOTE env. Pinning
# AIONUI_ALLOW_REMOTE=0 AFTER the EnvironmentFile line wins over anything a
# future /opt/livos/.env edit could inject (resolveAllowRemote short-circuits
# on AIONUI_ALLOW_REMOTE before ever consulting AIONUI_REMOTE), so :3020
# stays 127.0.0.1-only regardless of env drift.
Environment="AIONUI_ALLOW_REMOTE=0"
# Phase 253 — ACP orphan reaper. Claude/adapter/guide-MCP child processes spawned
# for a chat session can escape the unit's cgroup (re-parented to init), so a plain
# `systemctl restart liv-assistant` does NOT reap them (verified: KillMode=control-group
# leaves them behind). A hung/orphaned claude wedged on `session/new` (e.g. from a
# half-killed prior session) then blocks new sessions until manually pkilled — this was
# the root cause of the "Claude chat hangs after initialize" symptom on test boxes.
# Reap ONLY ACP-spawned children — matched by the non-interactive `--input-format
# stream-json` flag plus the adapter/guide binary names — so interactive terminal
# `claude`/`gemini` sessions (the Phase 253 CLI-tools feature, also run as bruce) are
# untouched. The `[x]` bracket trick keeps the reaper's own bash cmdline from self-matching.
# Runs as User=bruce, so it can only signal bruce's own processes. `-` prefix + `exit 0`
# make a no-match (nothing to reap) non-fatal.
ExecStartPre=-/bin/bash -c 'pkill -9 -f "[-]-input-format stream-json"; pkill -9 -f "claude-agent-ac[p]"; pkill -9 -f "mcp-guide-stdi[o]"; exit 0'
ExecStopPost=-/bin/bash -c 'pkill -9 -f "[-]-input-format stream-json"; pkill -9 -f "claude-agent-ac[p]"; pkill -9 -f "mcp-guide-stdi[o]"; exit 0'
ExecStart=/opt/liv-assistant/current/aionui-web start --port 3020 --data-dir /opt/liv-assistant/data --backend-bin /opt/liv-assistant/current/bundled-aioncore/linux-x64/aioncore
# LIVOS-049 (Phase 262 WS1): pin aionui-web to loopback. AIONUI_ALLOW_REMOTE=0
# above is the direct control (no --host flag exists upstream); this assertion
# is the drift backstop — it fail-stops the unit if a future AionUi bump ever
# binds :3020 non-loopback (defense-in-depth; UFW-deny 3020 is the operator
# WS6 step).
ExecStartPost=/bin/bash -c 'for i in $(seq 1 30); do ss -ltnH "sport = :3020" | grep -q . && break; sleep 1; done; if ss -ltnH "sport = :3020" | grep ":3020" | grep -vq "127.0.0.1:3020"; then echo "FATAL: aionui-web bound non-loopback on :3020" >&2; exit 1; fi'
Restart=on-failure
RestartSec=5
# Phase 269 hotfix — aionui-web ignores SIGTERM, so on `systemctl restart` systemd
# waited the FULL default TimeoutStopSec (90s) before SIGKILL → every restart was a
# ~90s TOTAL Liv AI outage (/liv/api/* 502, "AionUi çöktü açılmıyor"). This was the
# root cause of every restart-window outage across Phases 267-269 (deploy AND the
# 269-01 manual "Apply changes" restart). Bound the stop to 10s so the unresponsive
# process is SIGKILLed quickly → a restart now takes ~12s (10s stop + port re-listen)
# instead of ~92s. The ExecStopPost/ExecStartPre pkill reapers still clean ACP orphans.
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=liv-assistant

# Hardening (minimal — keep aionui's HTTP listener + claude CLI spawn working)
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=read-only
# Phase 253 GC-E — /home/bruce/.gemini added so the Gemini ACP agent can write
# its state.json / history under ProtectHome=read-only.
# Fresh-box fix (WSL field test 2026-06-11): `-` prefix = ignore-if-missing.
# Without it, systemd treats a missing path as FATAL namespace failure
# (226/NAMESPACE crash loop ×∞) — /home/bruce/.gemini does not exist on a
# fresh install until the Gemini agent first runs. The installer also
# pre-creates these bruce-owned so they're actually writable on day one.
ReadWritePaths=/opt/liv-assistant/data -/home/bruce/.claude -/home/bruce/.bun -/home/bruce/.cache -/home/bruce/.gemini

[Install]
WantedBy=multi-user.target
