    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/yargs": "^17.0.35",
    "typescript": "^5.7.0",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": ">=22.0.0"
