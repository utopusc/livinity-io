{
  "name": "@livos/cli",
  "version": "0.1.0",
  "description": "LivOS command-line interface — `liv` bin for vault, items, agents, and chat",
  "type": "module",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "bin": {
    "liv": "./dist/cli.js"
  },
  "files": [
    "dist",
    "prompts",
