; Local hoist pattern for Storybook 8 / Babel transitive resolution.
; Some Babel sub-modules (esbuild-register-loaded) can't resolve
; @jridgewell/gen-mapping through the strict pnpm symlink chain on Windows.
; Public-hoisting it into the ui-kit node_modules root resolves the
; "Cannot find module '@jridgewell/gen-mapping'" error during
; `storybook build`.
public-hoist-pattern[]=*@jridgewell/*
public-hoist-pattern[]=@babel/generator
public-hoist-pattern[]=@babel/traverse
