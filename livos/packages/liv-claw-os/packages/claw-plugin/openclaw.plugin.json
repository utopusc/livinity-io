{
  "id": "openclaw-os-plugin",
  "name": "Liv AI — OpenUI workspace",
  "description": "Liv AI: enables Generative UI in the Liv AI client by injecting the OpenUI Lang system prompt for direct WebSocket chat sessions.",
  "version": "0.1.6",
  "enabledByDefault": true,
  "activation": { "onStartup": true },
  "contracts": {
    "tools": [
      "create_markdown_artifact",
      "update_markdown_artifact",
      "get_artifact",
      "list_artifacts",
      "db_query",
      "db_execute",
      "app_create",
      "get_app",
      "app_update",
      "weather",
      "get_current_time",
      "ui_render",
      "luse_computer_screenshot",
      "luse_computer_click_mouse",
      "luse_computer_type_text",
      "luse_computer_press_keys",
      "luse_computer_application",
      "luse_computer_drag_mouse",
      "luse_computer_paste_text",
      "luse_list_windows",
      "luse_get_cursor_position"
    ]
  },
  "skills": ["./skills"],
  "configSchema": {
    "jsonSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  }
}
