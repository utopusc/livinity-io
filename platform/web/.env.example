# platform/web — Vercel runtime env vars
# Phase 146: Big-bang migration Server5 → Vercel + Supabase + Realtime presence.
# Sacred SHA f3538e1d811992b782a9bb057d1b7f0a0189f95f.

# === Database — Supabase Postgres pooler (transaction mode, port 6543) ===
DATABASE_URL=postgres://postgres.xxxxx:PWD@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true

# === Supabase project ===
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...                  # public-safe; returned in /api/me/realtime-token response for livinityd self-bootstrap
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...           # SERVER-ONLY; bypasses RLS; used by /api/dashboard presenceState reads
SUPABASE_JWT_SECRET=...                        # HS256 secret; signs the Realtime JWTs minted by /api/me/realtime-token

# === Cloudflare (DNS-only zone) ===
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID_LIVINITY_IO=

# === App secrets ===
SESSION_SECRET=
RESEND_API_KEY=                                # transactional email
TUNNEL_INSTALL_TOKEN_SECRET=                   # one-time install tokens

# Device-token signing secret (L-067). REQUIRED — device-auth fails closed if
# unset or equal to the old committed default. Set a strong random value in the
# Vercel project env (Settings -> Environment Variables), NOT here. Generate
# with: openssl rand -hex 32
DEVICE_JWT_SECRET=                             # leave empty here; set in Vercel env

# === Phase 147+ carryovers (NOT used in Phase 146) ===
# RELAY_INTERNAL_URL=  # removed from Vercel; was Server5-only relay HTTP API
